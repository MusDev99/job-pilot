# Copy to .env.local for local dev; set the same names in Netlify > Site configuration > Environment variables.
# Never commit real values.

# Google sign-in (Week 1). OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs session cookies.
AUTH_SECRET=
# Public origin, no trailing slash. The OAuth redirect URI to register is APP_URL + /api/auth/callback.
# Local: http://localhost:3000   Production: https://<your-site>
APP_URL=
# Optional: comma-separated emails allowed to sign up. Empty = anyone with a Google account.
# Keep it set while the Google OAuth app is in Testing mode.
SIGNUP_ALLOWLIST=

# Data store: Google Sheets via a service account with Editor access to one spreadsheet (Week 1).
SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# AI extraction and tailoring (Week 3).
ANTHROPIC_API_KEY=
JOB_MODEL=claude-opus-5-5

# Digest emails (Week 4).
RESEND_API_KEY=
ALERT_FROM_EMAIL=
